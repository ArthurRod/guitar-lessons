---
import {getCollection} from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import {SITE_DESCRIPTION, SITE_TITLE} from "../consts";

import "../styles/home.css";

const posts = (await getCollection("blog"))
  .sort((a, b) => (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0));

const publishedSlugs = new Set(posts.map((p) => p.id));

const phases = [
  {
    n: 1,
    title: "Fase 1 — Fundamentos",
    months: "Mês 1–2",
    lessons: [
      {n: 1, slug: "aula-1-primeiro-contato", title: "Partes do violão, nome das cordas e notas musicais", tag: "Fundamentos"},
      {n: 2, slug: "aula-2-notas-e-primeiros-acordes", title: "Notas no braço, conceito de tom e primeiros acordes", tag: "Fundamentos"},
    ],
  },
  {
    n: 2,
    title: "Fase 2 — Primeiros acordes + ritmo",
    months: "Mês 2–3",
    lessons: [
      {n: 3, slug: "aula-3-acordes-maiores", title: "Acordes maiores: D, A, G, C e E", tag: "Acordes"},
      {n: 4, slug: "aula-4-troca-e-ritmo", title: "Trocas de acordes, ritmos simples e primeira música", tag: "Ritmo"},
      {n: 5, slug: "aula-5-graus", title: "Graus 1, 4 e 5 — pensando como músico", tag: "Harmonia"},
      {n: 6, slug: "aula-6-campo-harmonico", title: "Campo harmônico — por que as músicas funcionam", tag: "Harmonia"},
    ],
  },
  {
    n: 3,
    title: "Fase 3 — Consciência musical",
    months: "Mês 4–5",
    lessons: [
      {n: 7, slug: "aula-7-campo-harmonico-maior", title: "Campo harmônico maior e o grau 6 (menor)", tag: "Harmonia"},
      {n: 8, slug: "aula-8-progressoes-worship", title: "Progressões worship comuns: 1-5-6-4", tag: "Harmonia"},
      {n: 9, slug: "aula-9-ritmo-e-dinamica", title: "Ritmos do worship e dinâmica", tag: "Ritmo"},
      {n: 10, slug: "aula-10-feeling", title: "Feeling e reconhecimento de padrões", tag: "Expressão"},
    ],
  },
  {
    n: 4,
    title: "Fase 4 — Expansão",
    months: "Mês 6–7",
    lessons: [
      {n: 11, slug: "aula-11-acordes-menores", title: "Acordes menores e introdução à pestana", tag: "Acordes"},
      {n: 12, slug: "aula-12-capotraste", title: "Transposição simples com capotraste", tag: "Técnica"},
      {n: 13, slug: "aula-13-musicas-completas", title: "Músicas completas com variações e dedilhado", tag: "Repertório"},
      {n: 14, slug: "aula-14-acompanhamento", title: "Construção de acompanhamento", tag: "Técnica"},
    ],
  },
  {
    n: 5,
    title: "Fase 5 — Independência",
    months: "Mês 8",
    lessons: [
      {n: 15, slug: "aula-15-arranjos-e-grupo", title: "Arranjos simples e tocar em grupo", tag: "Arranjo"},
      {n: 16, slug: "aula-16-independencia", title: "Independência musical — tocar sem depender da cifra", tag: "Independência"},
    ],
  },
];

const roadmap = phases.flatMap((p) => p.lessons);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="home">
      <div class="container">
        <section class="home-hero">
          <h1>Aprenda violão tocando</h1>
          <p>Aulas curtas, práticas e com música worship desde o primeiro dia. Sem decoreba, sem complicação — só o que você precisa pra tocar de verdade.</p>
          <div class="actions">
            <a class="btn-primary" href="/posts/aula-1-primeiro-contato">Começar pela Aula 1</a>
            <a class="btn-ghost" href="#aulas">Ver todas as aulas</a>
          </div>
        </section>

        <div class="section-title">
          <h2>Últimas aulas</h2>
          <span class="badge">{posts.length} publicada{posts.length === 1 ? "" : "s"}</span>
        </div>
        <section>
          <ul>
            {
              posts.slice(0, 5).map((post) => (
                <li>
                  <a href={`/posts/${post.id}`}>
                    <img
                      width={720}
                      height={360}
                      src={post.data.heroImage}
                      alt={post.data.title}
                      loading="lazy"
                    />
                    <h4 class="title">{post.data.title}</h4>
                    <p class="date">
                      {post.data.pubDate && <FormattedDate date={post.data.pubDate} />}
                    </p>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <div class="section-title" id="aulas">
          <h2>Roteiro completo do curso</h2>
          <span class="badge">5 fases</span>
        </div>
        {
          phases.map((phase) => (
            <>
              <div class="phase-header">
                <span class="phase-title">{phase.title}</span>
                <span class="phase-months">{phase.months}</span>
              </div>
              <ul class="timeline">
                {phase.lessons.map((l) => {
                  const published = publishedSlugs.has(l.slug);
                  return (
                    <li class={published ? "" : "locked"}>
                      {published ? (
                        <a href={`/posts/${l.slug}`}>
                          <span class="lesson-meta">
                            <span class="tag">Aula {l.n}</span>
                            <span>{l.tag}</span>
                          </span>
                          <span class="lesson-title">{l.title}</span>
                        </a>
                      ) : (
                        <a href="#" onclick="event.preventDefault()" aria-disabled="true" style="cursor:not-allowed;opacity:.7">
                          <span class="lesson-meta">
                            <span class="tag" style="background:#e5e7eb;color:#6b7280">Aula {l.n}</span>
                            <span>{l.tag}</span>
                          </span>
                          <span class="lesson-title">{l.title}</span>
                          <span class="lesson-soon">em breve</span>
                        </a>
                      )}
                    </li>
                  );
                })}
              </ul>
            </>
          ))
        }
      </div>
    </main>
    <Footer />
  </body>
</html>
